<Window x:Class="PhoneKey.UI.Views.QuickPairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enable 1-Click Auto-Unlock"
        Height="290" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI, Inter, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="⚡ 1-Click Phone Pairing" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Enter your Windows password once so PhoneKey can unlock your workstation when your phone is present." 
                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="Windows Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PbPassword" Height="36" Padding="10,6" Background="#1E293B" Foreground="White" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" KeyDown="PbPassword_KeyDown"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="🔒 Protected with Windows DPAPI LocalMachine encryption." FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryBtn}" DockPanel.Dock="Left" Width="90" Click="BtnCancel_Click"/>
            <Button x:Name="BtnConfirm" Content="Enable Auto-Unlock" Style="{StaticResource ModernBtn}" DockPanel.Dock="Right" Padding="18,8" IsDefault="True" Click="BtnConfirm_Click"/>
        </DockPanel>
    </Grid>
</Window>
