<Window x:Class="PhoneKey.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneKey - Zero-Trust Proximity Authentication" 
        Height="680" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI, Inter, sans-serif">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,24" Padding="0,0,0,16" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushPrimary}" CornerRadius="10" Width="40" Height="40" Margin="0,0,14,0">
                        <TextBlock Text="PK" FontWeight="Bold" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="PhoneKey" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Hardware-Backed Proximity Windows Logon" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="16" Padding="12,6" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServiceStatusDot" Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtServiceStatus" Text="Service: Running" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Live Status Hero Card -->
        <Border Grid.Row="1" Background="{StaticResource BrushCardDark}" CornerRadius="12" Padding="24" Margin="0,0,0,20" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Phone Connection State -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="PHONE CONNECTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="PhoneStatusDot" Width="10" Height="10" Fill="{StaticResource BrushWarning}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPhoneStatus" Text="Searching for phone..." FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPhoneModel" Text="BLE Peripheral: None" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>

                <!-- Cryptographic Authentication State -->
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="CRYPTOGRAPHIC AUTH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtAuthStatus" Text="Pending Challenge" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtHardwareSecurity" Text="Hardware: Unknown" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>

                <!-- Proximity & Signal Strength -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="PROXIMITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtProximityStatus" Text="Out of Range" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtRssiValue" Text=" (-- dBm)" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar x:Name="RssiProgressBar" Height="6" Maximum="100" Value="20" Background="#0F172A" Foreground="{StaticResource BrushSuccess}" Margin="0,4,0,4"/>
                    <TextBlock x:Name="TxtGracePeriod" Text="Auto-lock grace period: Idle" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Control Buttons -->
        <Border Grid.Row="2" Margin="0,0,0,24">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="BtnLockNow" Content="🔒 Lock now" Style="{StaticResource DangerBtn}" Margin="0,0,12,8" Click="BtnLockNow_Click"/>
                <Button x:Name="BtnRegisterPhone" Content="📱 Register phone" Style="{StaticResource ModernBtn}" Margin="0,0,12,8" Click="BtnRegisterPhone_Click"/>
                <Button x:Name="BtnRemovePhone" Content="🗑️ Remove phone" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,8" Click="BtnRemovePhone_Click"/>
                <Button x:Name="BtnSettings" Content="⚙️ Settings" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,8" Click="BtnSettings_Click"/>
                <Button x:Name="BtnDiagnostics" Content="🛡️ Security diagnostics" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,8" Click="BtnDiagnostics_Click"/>
            </WrapPanel>
        </Border>

        <!-- Settings & Configuration Panel -->
        <Border Grid.Row="3" Background="{StaticResource BrushCardDark}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Security &amp; Proximity Preferences" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Auto-Lock Switch -->
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Automatic Workstation Lock" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Automatically lock Windows when your phone moves out of proximity." FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkAutoLock" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Passwordless Unlock Switch -->
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Passwordless Phone Unlock" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Allow instant logon without typing password when phone is verified in proximity." FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkPasswordless" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Grace Period Slider -->
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left" Width="380">
                            <TextBlock Text="Departure Grace Period" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Time in seconds to tolerate packet drops before initiating Windows lock." FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Slider x:Name="SliderGrace" Minimum="5" Maximum="60" Value="15" Width="200" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtGraceValue" Text="{Binding ElementName=SliderGrace, Path=Value, StringFormat={}{0:0}s}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Sensitivity Slider -->
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left" Width="380">
                            <TextBlock Text="Unlock Proximity Sensitivity (RSSI)" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Closer distance required to trigger logon (-75 dBm to -55 dBm)." FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Slider x:Name="SliderSensitivity" Minimum="-80" Maximum="-50" Value="-65" Width="200" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtSensitivityValue" Text="{Binding ElementName=SliderSensitivity, Path=Value, StringFormat={}{0:0} dBm}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Recovery Info Banner -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,10,0,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ℹ️ Secure Fallback Guaranteed" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushPrimary}"/>
                            <TextBlock Text="Windows PIN, Windows Hello, and Password remain available at all times via 'Sign-in options' on the Windows lock screen. You can never be locked out." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
